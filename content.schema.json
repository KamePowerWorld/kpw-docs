{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KamePowerWorld/kpw-docs/content.schema.json",
  "title": "KamePowerWorld documentation front matter",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "order", "draft", "eyebrow", "heroLead", "credits"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "order": { "type": "integer", "minimum": 0 },
    "draft": { "type": "boolean" },
    "eyebrow": { "type": "string", "minLength": 1, "maxLength": 100 },
    "heroLead": { "type": "string", "minLength": 1, "maxLength": 160 },
    "heroImage": { "type": "string", "pattern": "^\\./assets/[A-Za-z0-9._-]+$" },
    "credits": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
